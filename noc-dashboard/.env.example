# Copy to .env and fill in. NEVER commit .env.

# PRTG web server base URL (no trailing slash)
PRTG_URL=https://asl-opmanager.alasilaccbu.com

# Auth option 1 (preferred): API key of a READ-ONLY PRTG user
PRTG_APITOKEN=

# Auth option 2 (fallback, older PRTG): username + passhash of a read-only user
# PRTG_USER=noc-dashboard
# PRTG_PASSHASH=

# TLS to PRTG
# If PRTG uses a cert from your internal CA, export the CA (Base64/PEM) and point to it:
# PRTG_CA_FILE=C:\noc-dashboard\internal-ca.pem
# Last resort only (lab): skip certificate validation
PRTG_INSECURE_TLS=0

# Dashboard web server
PORT=8080
BIND=0.0.0.0
CACHE_SECONDS=15
PRTG_TIMEOUT_MS=15000

# Optional login for the dashboard page itself (HTTP Basic). Leave empty to disable.
DASH_USER=
DASH_PASS=
