# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The address users and remote probes use to reach the server (HTTPS in production).
PUBLIC_URL=https://noc.example.com
# 1 when served over HTTPS (session cookie marked Secure).
COOKIE_SECURE=1
HTTP_PORT=3000
# Token of a probe created in the UI, for the optional local probe (--profile local-probe).
PROBE_TOKEN=
