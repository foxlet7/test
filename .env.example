# API (services/api). In production these are REQUIRED and the server refuses to start without them.
DATABASE_URL=postgres://user:pass@host:5432/gdc
JWT_SECRET=                 # 32+ random chars
EVIDENCE_KEY_HEX=           # 64 hex chars (AES-256 key). Losing it makes stored evidence unreadable; rotate per RUNBOOK.
EVIDENCE_BACKEND=local      # local | s3
EVIDENCE_DIR=/data/evidence
# S3_BUCKET= S3_REGION= S3_ENDPOINT=
CORS_ORIGINS=https://admin.example.org
APPEAL_WINDOW_DAYS=14
ASSESSMENT_PROVIDER=none    # none | mock. A real provider is a deliberate, reviewed integration (see docs/DECISIONS.md).
PORT=8080

# Admin (apps/admin)
NEXT_PUBLIC_API_URL=https://api.example.org
