**/node_modules
**/dist
**/dist-seed
**/.expo
/apps/api/uploads
/uploads
.git
.github
apps/mobile
apps/admin
apps/android-shell
tests
docs
noc-dashboard
*.apk
**/.env
**/.env.*
!**/.env.example
