{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "https://api.staging.example.com" } },
    "preview": { "distribution": "internal", "ios": { "image": "latest" }, "env": { "EXPO_PUBLIC_API_URL": "https://api.staging.example.com" } },
    "production": {
      "autoIncrement": true,
      "ios": { "image": "latest" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.example.com", "EXPO_PUBLIC_PRIVACY_URL": "https://example.com/privacy", "EXPO_PUBLIC_TERMS_URL": "https://example.com/terms", "EXPO_PUBLIC_SUPPORT_URL": "https://example.com/support" }
    }
  },
  "submit": { "production": {} }
}
