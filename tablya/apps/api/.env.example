# ── Runtime ──
NODE_ENV=development            # development | staging | production | test
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173   # comma-separated admin/web origins; mobile apps don't need CORS

# ── Database (PostgreSQL 14+, pg_trgm available) ──
DATABASE_URL=postgresql://tablya:CHANGE_ME@localhost:5432/tablya

# ── Secrets (generate fresh values per environment; never commit real ones) ──
# openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_random
# openssl rand -base64 32   (32 bytes; encrypts TOTP secrets at rest)
DATA_ENC_KEY=CHANGE_ME_base64_32_bytes
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ── Money / marketplace ──
CURRENCY=SAR
TAX_BPS=1500                    # 15.00% VAT, basis points. Admin can override at runtime (SUPER_ADMIN)
SERVICE_FEE_BPS=0
DEFAULT_COMMISSION_BPS=1500

# ── Payments ──
PAYMENT_PROVIDER=sandbox        # sandbox is development-only; production requires a real adapter (see docs/ARCHITECTURE.md)
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_min_16_chars

# ── Messaging / push ──
MESSAGE_PROVIDER=console        # development-only; implement MessageProvider for email/SMS in production
EXPO_PUSH_ENABLED=false
EXPOSE_DEV_OTP=false            # never true in production

# ── Staff security ──
REQUIRE_ADMIN_MFA=false         # must be true in production

# ── Storage ──
STORAGE_DIR=./uploads           # local-disk adapter; swap StorageProvider for S3/GCS in production

# ── Rate limiting (per IP per minute) ──
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ── Order automation ──
UNPAID_ORDER_TTL_MINUTES=15
COOK_ACCEPT_TTL_MINUTES=15
AUTO_COMPLETE_HOURS=24
